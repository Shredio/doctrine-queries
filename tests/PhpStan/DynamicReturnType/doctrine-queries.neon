services:
	-
		class: Shredio\DoctrineQueries\PhpStan\TypeExtension\DoctrineQueriesDynamicReturnTypeExtension
		arguments:
			- @Shredio\DoctrineQueries\PhpStan\PhpStanAnalyzerFactory
		tags:
			- phpstan.broker.dynamicMethodReturnTypeExtension
	-
		class: Shredio\DoctrineQueries\PhpStan\PhpStanAnalyzerFactory
	-
		factory: PHPStan\Type\Doctrine\Descriptors\ReflectionDescriptor('Tests\Doctrine\SymbolType')
		tags:
			- phpstan.doctrine.typeDescriptor
	-
		factory: PHPStan\Type\Doctrine\Descriptors\ReflectionDescriptor('Tests\Doctrine\FloatDecimalType')
		tags:
			- phpstan.doctrine.typeDescriptor

includes:
	- ../../../vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
	doctrine:
		objectManagerLoader: ../Data/entity-manager.php
		reportUnknownTypes: true
