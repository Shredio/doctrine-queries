{
	"name": "shredio/doctrine-queries",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.3",
		"doctrine/orm": "^3.7",
		"doctrine/dbal": "^4.0",
		"symfony/polyfill-php86": "^1.41"
	},
	"autoload": {
		"psr-4": {
			"Shredio\\DoctrineQueries\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=-1",
		"test": "vendor/bin/phpunit tests",
		"infection": [
			"@putenv XDEBUG_MODE=coverage",
			"infection --threads=max --show-mutations"
		]
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^12.2",
		"phpstan/phpstan-doctrine": "^2.0",
		"doctrine/orm": "^3.7",
		"symfony/cache": "^7.3",
		"symfony/clock": "^7.3",
		"shipmonk/doctrine-entity-preloader": "^1.4",
		"infection/infection": "^0.35.12"
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		}
	}
}
